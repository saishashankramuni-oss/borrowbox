# BorrowBox Local Development Environment Variables
# For zero-config local run, Spring Boot defaults to embedded H2 database automatically.
# To connect to a local MySQL 8 database, set the following:

# Database Configuration (Local MySQL 8)
DB_URL=jdbc:mysql://localhost:3306/borrowbox_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=rootpassword
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Server Port
PORT=8080

# Security JWT Secret Key
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://localhost:8080,http://127.0.0.1:5500,http://127.0.0.1:8080

# Local Upload Directory
UPLOAD_DIR=uploads
