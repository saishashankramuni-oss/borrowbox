# ==============================================================================
# BorrowBox Production Environment Variables Template
# Use these environment variables when configuring Render & Railway
# ==============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render automatically sets $PORT)
SERVER_PORT=8080

# Database Configuration (Railway MySQL 8)
# Example Railway JDBC URL: jdbc:mysql://roundhouse.proxy.rlwy.net:12345/railway?useSSL=true&requireSSL=false&serverTimezone=UTC
DB_URL=jdbc:mysql://<RAILWAY_HOST>:<RAILWAY_PORT>/<RAILWAY_DATABASE>?useSSL=true&requireSSL=false&serverTimezone=UTC
DB_USERNAME=<RAILWAY_USER>
DB_PASSWORD=<RAILWAY_PASSWORD>
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Database Connection Pool Tuning
DB_POOL_MAX=10
DB_POOL_MIN=3

# JWT Secret Key (Generate a 256-bit strong random hex key for production)
# Example command to generate: openssl rand -hex 32
JWT_SECRET=ReplaceWithAStrongSecure256BitHexSecretKeyHereForProduction
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated list of allowed frontend domains)
# Example: https://borrowbox.netlify.app
CORS_ALLOWED_ORIGINS=https://your-borrowbox-site.netlify.app

# Persistent File Upload Storage Directory Path
UPLOAD_DIR=/app/uploads
