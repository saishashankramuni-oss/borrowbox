# ==============================================================================
# BorrowBox Production Environment Variables Template
# Use these environment variables when configuring Render, Railway, or VPS
# ==============================================================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Server Port (Render & Railway automatically inject $PORT)
SERVER_PORT=8080
PORT=8080
SERVER_ADDRESS=0.0.0.0

# Database Configuration (MySQL 8)
# Example Railway JDBC URL: jdbc:mysql://roundhouse.proxy.rlwy.net:12345/railway?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_URL=jdbc:mysql://<HOST>:<PORT>/<DATABASE>?useSSL=true&requireSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=<MYSQL_USER>
DB_PASSWORD=<MYSQL_PASSWORD>
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# Database Connection Pool (HikariCP)
DB_POOL_MAX=10
DB_POOL_MIN=5

# JWT Secret Key (256-bit strong random hex key)
JWT_SECRET=e42dba7b8590d453b06610da5f16d26495bb49ec714e1454c7107774dcc8a26c
JWT_EXPIRATION=86400000

# CORS Allowed Origins (Comma-separated list of exact domains or wildcard patterns)
CORS_ALLOWED_ORIGINS=https://*.netlify.app,https://*.onrender.com,https://*.railway.app

# Persistent File Upload Storage Directory Path
UPLOAD_DIR=/app/uploads
